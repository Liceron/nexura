"""The agent: one read tool, one write tool that waits for a person, and a budget.

Without configuration the agent runs on ``demo_model()``, a scripted ``FakeModel``: no API key,
no network and no cost. Set ``NEXURA_MODEL`` (for example ``openai:gpt-4.1-mini``) and that
provider's API key to use a real model; see README.md.
"""

from __future__ import annotations

import os
from decimal import Decimal

from nexura_agents import (
    Agent,
    BudgetConfig,
    BudgetManager,
    FakeModel,
    ModelPricing,
    ModelSettings,
    Runner,
    ToolCall,
    Usage,
    tool,
)

#: Stand-in order data. Replace with a call to your order system.
ORDERS = {
    "ORD-1": {"status": "delivered", "total": 40},
    "ORD-2": {"status": "shipped", "total": 125},
}

#: Refunds issued so far. Stands in for a payment API; tests read it.
REFUNDS: list[tuple[str, int]] = []


def refund(order_id: str, amount: int) -> str:
    """Issue the refund. This is the side effect a person approves first."""
    if order_id not in ORDERS:
        raise ValueError(f"unknown order {order_id}")
    if amount <= 0 or amount > ORDERS[order_id]["total"]:
        raise ValueError(f"refund amount {amount} is not between 1 and the order total")
    REFUNDS.append((order_id, amount))
    return f"refunded {amount} for {order_id}"


@tool
def lookup_order(order_id: str) -> str:
    """Look up an order's status and total."""
    order = ORDERS.get(order_id)
    if order is None:
        return f"No order {order_id}."
    return f"{order_id}: {order['status']}, total {order['total']}"


@tool(requires_approval=True)
def issue_refund(order_id: str, amount: int) -> str:
    """Refund an order. A person must approve each call before it runs."""
    return refund(order_id, amount)


INSTRUCTIONS = (
    "You are a support agent. Look up the order before acting. Issue a refund only when the "
    "customer asks for one, and never for more than the order total."
)

#: Reported per call by the demo model, so the budget has something to count.
DEMO_USAGE = Usage(prompt_tokens=40, completion_tokens=20, total_tokens=60)


def demo_model() -> FakeModel:
    """A scripted model: look up ORD-1, ask to refund 40, then confirm."""
    return FakeModel(
        responses=[
            [ToolCall(id="c1", name="lookup_order", arguments={"order_id": "ORD-1"})],
            [ToolCall(id="c2", name="issue_refund", arguments={"order_id": "ORD-1", "amount": 40})],
            "Refunded 40 for ORD-1.",
        ],
        default_usage=DEMO_USAGE,
    )


def build_agent(model: object | None = None) -> Agent:
    """The support agent. ``model`` defaults to NEXURA_MODEL, else the demo model."""
    chosen = model or os.environ.get("NEXURA_MODEL") or demo_model()
    return Agent(
        name="support",
        instructions=INSTRUCTIONS,
        model=chosen,  # type: ignore[arg-type]
        tools=[lookup_order, issue_refund],
        # A max_tokens setting keeps the budget's pre-call estimate small.
        model_settings=ModelSettings(max_tokens=200),
    )


def build_runner(max_tokens: int = 2000, max_cost_usd: Decimal = Decimal("0.05")) -> Runner:
    """A runner with a token and money budget shared by every call it makes.

    Each model call is admitted only if its estimate fits, then settled at the usage the model
    reported. The demo model's id is ``fake-model``; give a real model its own price with
    ``add_model_pricing`` (a money cap refuses a model with no price).
    """
    manager = BudgetManager()
    manager.pricing_table.add_model_pricing(
        ModelPricing(
            model_id="fake-model",
            input_cost_per_million=Decimal("2.50"),
            output_cost_per_million=Decimal("10"),
            source="example price for the demo model",
        )
    )
    budget = manager.create_run_budget(
        "local",
        "{{package}}",
        config=BudgetConfig(max_tokens=max_tokens, max_cost_usd=max_cost_usd),
    )
    return Runner(budget=budget)
