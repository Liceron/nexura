# Copy to .env (never commit it) and fill in only what you use. Empty means "not set": the
# project then uses the offline test embedder and the scripted model.
# A real embedder: openai:text-embedding-3-small, gemini:gemini-embedding-001 or
# vertex:text-embedding-005. Changing it needs a fresh index (delete the old database).
NEXURA_EMBEDDINGS=
# Only for models Nexura does not know: the embedding size the model returns
NEXURA_EMBEDDINGS_DIMENSIONS=
# A chat model string such as openai:gpt-4.1-mini or gemini:gemini-2.5-flash
NEXURA_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
