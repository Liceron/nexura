# syntax=docker/dockerfile:1
# Single-user image for {{project_name}}, written by `nexura-runtime deploy --target docker`.
# Nothing was built or run. Read DEPLOY.md first.
#
# The container runs `nexura-runtime dev --container`: the bundled Studio with this project's
# workflows, listening on 0.0.0.0 inside the container. It refuses to start unless
# NEXURA_STUDIO_TOKEN is set, and the port must be published on 127.0.0.1 only:
#
#   docker build -t {{project_name}} .
#   export NEXURA_STUDIO_TOKEN="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
#   docker run --rm -p 127.0.0.1:{{port}}:{{port}} -e NEXURA_STUDIO_TOKEN \
#       -v {{project_name}}-data:/app/.nexura {{project_name}}
#
# Never publish on 0.0.0.0 and never add --insecure-allow-unauthenticated-network.

FROM python:3.12-slim

# Until Nexura {{nexura_version}} is on PyPI: copy its wheels into ./wheels/ and build with
#   docker build --build-arg PIP_FIND_LINKS=/app/wheels -t {{project_name}} .
ARG PIP_FIND_LINKS=""

RUN groupadd -g 10001 nexura && \
    useradd -u 10001 -g nexura -s /bin/sh -m -d /home/nexura nexura

WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir ${PIP_FIND_LINKS:+--find-links "$PIP_FIND_LINKS"} /app && \
    mkdir -p /app/.nexura && chown -R nexura:nexura /app/.nexura

USER 10001:10001
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE {{port}}
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{port}}/healthz').read()"]

CMD ["nexura-runtime", "dev", "--container", "--project", "/app", "--data-dir", "/app/.nexura", "--studio-port", "{{port}}"]
