{
  "name": "@liceron/nexura-sdk",
  "version": "0.4.0",
  "description": "TypeScript HTTP client for the Nexura Service API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "nexura",
    "agentkit",
    "ai",
    "sdk",
    "client",
    "agents",
    "workflows",
    "approvals",
    "typescript"
  ],
  "author": "Liceron <info@liceron.in>",
  "license": "MIT",
  "homepage": "https://github.com/Liceron/nexura/tree/main/clients/typescript#readme",
  "bugs": {
    "url": "https://github.com/Liceron/nexura/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liceron/nexura.git",
    "directory": "clients/typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
